<?xml version="1.0"?>
<sdf version="1.9">
  <model name="victim">
    <static>true</static>
    <!-- Same geometry as the validated house tests (tools/spawn_victim.sh): 2 cm base plate + person mesh. -->
    <link name="link">
      <collision name="bottom"><pose>0 -0.1 0.01 0 0 0</pose><geometry><box><size>0.5 0.35 0.02</size></box></geometry></collision>
      <collision name="person"><pose>0 0 0.02 0.04 0 0</pose><geometry><mesh><uri>model://victim/meshes/standing.dae</uri></mesh></geometry></collision>
      <visual name="visual"><pose>0 0 0.02 0.04 0 0</pose><geometry><mesh><uri>model://victim/meshes/standing.dae</uri></mesh></geometry></visual>
    </link>
  </model>
</sdf>
